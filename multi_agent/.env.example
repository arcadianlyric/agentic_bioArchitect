# API Keys for UMI 16S rRNA Multi-Agent Pipeline
# Copy to .env and fill in your actual keys

# Grok (xAI) - default LLM for all agents
GROK_API_KEY=xai-your-grok-api-key-here

# DeepSeek - alternative LLM (optional, for dual-LLM mode)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# Tavily - web search for Researcher agent
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# PubMed - literature search
PUBMED_EMAIL=your.email@example.com
